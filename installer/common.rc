#include <windows.h>
#include "version.h"
101 ICON "../res/SeedFlow.ico"
1 RT_MANIFEST "SeedFlowSetup.manifest"
1 VERSIONINFO
 FILEVERSION SF_FILE_VERSION
 PRODUCTVERSION SF_FILE_VERSION
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "SeedFlow Setup"
   VALUE "ProductName", "SeedFlow"
   VALUE "FileVersion", SF_FILE_VERSION_STRING
   VALUE "ProductVersion", SF_VERSION_STRING
   VALUE "OriginalFilename", "SeedFlowSetup.exe"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
