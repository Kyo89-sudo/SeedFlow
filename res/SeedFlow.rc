    LTEXT           "Componenti, licenze e informazioni di sistema", -1, 10, 86, 300, 9
    EDITTEXT        IDC_REPORT, 10, 97, 300, 128, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON      "Copia info di sistema", IDC_COPY, 10, 231, 86, 15
