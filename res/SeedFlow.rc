    AUTOCHECKBOX    "La X chiude nell'area di notifica", IDC_CLOSETRAY, 8, 12, 260, 10
    AUTOCHECKBOX    "Riduci a icona nell'area di notifica", IDC_MINTRAY, 8, 26, 260, 10
    AUTOCHECKBOX    "Conferma prima di rimuovere un torrent", IDC_CONFIRMREMOVE, 8, 40, 260, 10
    GROUPBOX        "Avvio", -1, 0, 62, 276, 42
    AUTOCHECKBOX    "Avvia con Windows", IDC_AUTOSTART, 8, 74, 260, 10
    AUTOCHECKBOX    "Ridotto a icona nell'area di notifica", IDC_STARTMIN, 20, 88, 248, 10
    GROUPBOX        "Nuovi torrent", -1, 0, 110, 276, 42
    AUTOCHECKBOX    "Aggiungi in pausa", IDC_STARTPAUSED, 8, 122, 260, 10
    AUTOCHECKBOX    "Chiedi dove salvare i file .torrent", IDC_ASKPATH, 8, 136, 260, 10
    GROUPBOX        "Barra di stato", -1, 0, 158, 276, 68
    AUTOCHECKBOX    "Rete e porta", IDC_SB_NET, 8, 170, 124, 10
    AUTOCHECKBOX    "Nodi DHT", IDC_SB_DHT, 8, 184, 124, 10
    AUTOCHECKBOX    "Download", IDC_SB_DOWN, 8, 198, 124, 10
    AUTOCHECKBOX    "Upload", IDC_SB_UP, 140, 170, 128, 10
    AUTOCHECKBOX    "Totali e ratio", IDC_SB_TOTALS, 140, 184, 128, 10
    AUTOCHECKBOX    "Memoria (RAM)", IDC_SB_RAM, 140, 198, 128, 10
