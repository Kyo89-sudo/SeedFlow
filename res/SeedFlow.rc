IDD_WIZARD DIALOGEX 0, 0, 420, 300
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Ottimizza per la mia connessione"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Scegli il tipo di linea: le impostazioni di libtorrent vengono calcolate in base alla banda reale. Usa i valori misurati con uno speed test, non quelli nominali del contratto.", -1, 8, 6, 404, 18
    LTEXT           "Connessione", -1, 8, 30, 60, 9
    COMBOBOX        IDC_CONNTYPE, 72, 28, 170, 120, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Download (Mb/s)", -1, 250, 30, 60, 9
    EDITTEXT        IDC_DOWNMBPS, 312, 28, 40, 13, WS_TABSTOP
    LTEXT           "Upload", -1, 358, 30, 26, 9
    EDITTEXT        IDC_UPMBPS, 384, 28, 28, 13, WS_TABSTOP
    LTEXT           "Disco", -1, 8, 48, 60, 9
    COMBOBOX        IDC_DISKTYPE, 72, 46, 170, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Priorità", -1, 250, 48, 60, 9
    COMBOBOX        IDC_RAMPRIO, 312, 46, 100, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    AUTOCHECKBOX    "Limita l'upload per lasciare banda agli altri dispositivi", IDC_LIMITUP, 8, 66, 300, 10
    PUSHBUTTON      "Calcola", IDC_CALC, 362, 63, 50, 15
    CONTROL         "", IDC_RESULTS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 8, 84, 404, 186
    LTEXT           "Le impostazioni vengono applicate subito e salvate. Puoi ritoccarle da Opzioni.", -1, 8, 278, 250, 9
    DEFPUSHBUTTON   "Applica", IDOK, 308, 276, 50, 14
    PUSHBUTTON      "Annulla", IDCANCEL, 362, 276, 50, 14
END

