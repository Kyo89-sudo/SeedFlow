// SeedFlow resources (UTF-8)
#pragma code_page(65001)
#include <winres.h>
#include "../src/resource.h"
#include "../src/version.h"

LANGUAGE LANG_ITALIAN, SUBLANG_ITALIAN

IDI_APP ICON "SeedFlow.ico"

// Icon set (stile A) - strisce PNG generate da tools/make_icons.py; ID = IDR_ICONS_BASE + dimensione
2016 RCDATA "icons/strip16.png"
2020 RCDATA "icons/strip20.png"
2024 RCDATA "icons/strip24.png"
2028 RCDATA "icons/strip28.png"
2032 RCDATA "icons/strip32.png"
2040 RCDATA "icons/strip40.png"
2048 RCDATA "icons/strip48.png"
1 24 "SeedFlow.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SF_FILE_VERSION
 PRODUCTVERSION SF_FILE_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041004b0"
        BEGIN
            VALUE "CompanyName", "SeedFlow"
            VALUE "FileDescription", "SeedFlow - client BitTorrent"
            VALUE "FileVersion", SF_FILE_VERSION_STRING
            VALUE "InternalName", "SeedFlow"
            VALUE "OriginalFilename", "SeedFlow.exe"
            VALUE "ProductName", "SeedFlow"
            VALUE "ProductVersion", SF_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x410, 1200
    END
END

IDR_ACCEL ACCELERATORS
BEGIN
    "O", ID_FILE_OPEN, VIRTKEY, CONTROL
    "U", ID_FILE_MAGNET, VIRTKEY, CONTROL
    "V", ID_FILE_PASTE, VIRTKEY, CONTROL
    "N", ID_FILE_CREATE, VIRTKEY, CONTROL
    "A", ID_T_SELECTALL, VIRTKEY, CONTROL
    VK_DELETE, ID_T_REMOVE, VIRTKEY
    VK_DELETE, ID_T_DELETE, VIRTKEY, SHIFT
    VK_F5, ID_T_REANNOUNCE, VIRTKEY
    "P", ID_OPT_PREFS, VIRTKEY, CONTROL
END

IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "Apri file .torrent...\tCtrl+O", ID_FILE_OPEN
        MENUITEM "Aggiungi magnet...\tCtrl+U", ID_FILE_MAGNET
        MENUITEM "Incolla magnet dagli appunti\tCtrl+V", ID_FILE_PASTE
        MENUITEM SEPARATOR
        MENUITEM "Crea torrent...\tCtrl+N", ID_FILE_CREATE
        MENUITEM SEPARATOR
        MENUITEM "Avvia tutti", ID_T_STARTALL
        MENUITEM "Metti tutti in pausa", ID_T_PAUSEALL
        MENUITEM SEPARATOR
        MENUITEM "Esci", ID_FILE_EXIT
    END
    POPUP "&Opzioni"
    BEGIN
        MENUITEM "Chiudi nell'area di notifica (X)", ID_OPT_CLOSETRAY
        MENUITEM "Minimizza nell'area di notifica", ID_OPT_MINTRAY
        MENUITEM "Aggiungi i nuovi torrent in pausa", ID_OPT_STARTPAUSED
        MENUITEM "Chiedi conferma prima di rimuovere", ID_OPT_CONFIRMREMOVE
        MENUITEM SEPARATOR
        MENUITEM "Preferenze...\tCtrl+P", ID_OPT_PREFS
    END
    POPUP "&Strumenti"
    BEGIN
        MENUITEM "Ottimizza per la mia connessione...", ID_TOOLS_WIZARD
        MENUITEM "Diagnostica rete...", ID_TOOLS_DIAG
        MENUITEM "Statistiche...", ID_TOOLS_STATS
        MENUITEM SEPARATOR
        MENUITEM "Apri cartella dati SeedFlow", ID_TOOLS_DATAFOLDER
    END
    POPUP "&Aiuto"
    BEGIN
        MENUITEM "Informazioni su SeedFlow", ID_HELP_ABOUT
    END
END

IDR_CTX_TORRENT MENU
BEGIN
    POPUP "torrent"
    BEGIN
        MENUITEM "Avvia", ID_T_START
        MENUITEM "Avvio forzato (ignora la coda)", ID_T_FORCESTART
        MENUITEM "Pausa", ID_T_PAUSE
        MENUITEM SEPARATOR
        MENUITEM "Copia magnet", ID_T_COPYMAGNET
        MENUITEM "Apri cartella", ID_T_OPENFOLDER
        MENUITEM "Sposta in un'altra cartella...", ID_T_MOVE
        MENUITEM SEPARATOR
        MENUITEM "Limite ratio...", ID_T_RATIO
        MENUITEM "Limiti di velocità...", ID_T_LIMITS
        MENUITEM "Attiva/disattiva Super-seeding", ID_T_SUPERSEED
        POPUP "Coda"
        BEGIN
            MENUITEM "In cima", ID_T_QTOP
            MENUITEM "Su", ID_T_QUP
            MENUITEM "Giù", ID_T_QDOWN
            MENUITEM "In fondo", ID_T_QBOTTOM
        END
        MENUITEM "Riannuncia ai tracker\tF5", ID_T_REANNOUNCE
        MENUITEM "Verifica forzata", ID_T_RECHECK
        MENUITEM SEPARATOR
        MENUITEM "Rimuovi (conserva i file)\tCanc", ID_T_REMOVE
        MENUITEM "Rimuovi e cancella i file\tMaiusc+Canc", ID_T_DELETE
    END
END

IDR_CTX_TRACKER MENU
BEGIN
    POPUP "tracker"
    BEGIN
        MENUITEM "Aggiungi tracker...", ID_TR_ADD
        MENUITEM "Rimuovi tracker selezionati", ID_TR_REMOVE
        MENUITEM "Copia URL", ID_TR_COPY
        MENUITEM SEPARATOR
        MENUITEM "Riannuncia ora", ID_TR_REANNOUNCE
    END
END

IDR_CTX_FILE MENU
BEGIN
    POPUP "file"
    BEGIN
        MENUITEM "Apri", ID_F_OPEN
        MENUITEM SEPARATOR
        MENUITEM "Non scaricare", ID_F_SKIP
        MENUITEM "Priorità bassa", ID_F_LOW
        MENUITEM "Priorità normale", ID_F_NORMAL
        MENUITEM "Priorità alta", ID_F_HIGH
    END
END

IDR_CTX_TRAY MENU
BEGIN
    POPUP "tray"
    BEGIN
        MENUITEM "Apri SeedFlow", ID_TRAY_OPEN
        MENUITEM SEPARATOR
        MENUITEM "Avvia tutti", ID_T_STARTALL
        MENUITEM "Metti tutti in pausa", ID_T_PAUSEALL
        MENUITEM SEPARATOR
        MENUITEM "Chiudi nell'area di notifica (X)", ID_OPT_CLOSETRAY
        MENUITEM "Minimizza nell'area di notifica", ID_OPT_MINTRAY
        MENUITEM SEPARATOR
        MENUITEM "Esci", ID_FILE_EXIT
    END
END

// ------------------------------------------------------------------ dialogs
IDD_MAGNET DIALOGEX 0, 0, 340, 168
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Aggiungi magnet"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Incolla uno o più magnet link (uno per riga):", -1, 8, 8, 320, 9
    EDITTEXT        IDC_EDIT, 8, 20, 324, 76, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Salva in:", -1, 8, 104, 40, 9
    EDITTEXT        IDC_FOLDER, 8, 115, 276, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Sfoglia...", IDC_BROWSE, 288, 114, 44, 15
    AUTOCHECKBOX    "Aggiungi in pausa", IDC_PAUSED, 8, 134, 120, 10
    DEFPUSHBUTTON   "Aggiungi", IDOK, 228, 148, 50, 14
    PUSHBUTTON      "Annulla", IDCANCEL, 282, 148, 50, 14
END

// ------------------------------------------------------------------ preferences (unified, uTorrent style)
IDD_PREFS DIALOGEX 0, 0, 526, 326
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Preferenze"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_PREFTREE, "SysTreeView32", TVS_SHOWSELALWAYS | TVS_FULLROWSELECT | TVS_HASBUTTONS | TVS_LINESATROOT | TVS_TRACKSELECT | WS_BORDER | WS_TABSTOP, 8, 8, 160, 290
    LTEXT           "", IDC_PAGETITLE, 176, 8, 342, 12
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 176, 22, 342, 1
    LTEXT           "", IDC_PAGEAREA, 176, 28, 342, 272, NOT WS_VISIBLE
    DEFPUSHBUTTON   "OK", IDOK, 360, 306, 50, 14
    PUSHBUTTON      "Annulla", IDCANCEL, 414, 306, 50, 14
    PUSHBUTTON      "Applica", IDC_APPLYNOW, 468, 306, 50, 14
END

IDD_PG_GENERAL DIALOGEX 0, 0, 342, 272
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Finestra e area di notifica", -1, 0, 0, 342, 64
    AUTOCHECKBOX    "Chiudi nell'area di notifica quando premi la X", IDC_CLOSETRAY, 8, 14, 326, 10
    AUTOCHECKBOX    "Riduci nell'area di notifica quando minimizzi", IDC_MINTRAY, 8, 28, 326, 10
    AUTOCHECKBOX    "Chiedi conferma prima di rimuovere un torrent", IDC_CONFIRMREMOVE, 8, 42, 326, 10
    GROUPBOX        "Avvio", -1, 0, 70, 342, 50
    AUTOCHECKBOX    "Avvia SeedFlow all'accesso a Windows", IDC_AUTOSTART, 8, 84, 326, 10
    AUTOCHECKBOX    "Avvia ridotto nell'area di notifica", IDC_STARTMIN, 20, 98, 314, 10
    GROUPBOX        "Nuovi torrent", -1, 0, 126, 342, 46
    AUTOCHECKBOX    "Aggiungi i nuovi torrent in pausa", IDC_STARTPAUSED, 8, 140, 326, 10
    AUTOCHECKBOX    "Chiedi dove salvare quando aggiungi un file .torrent", IDC_ASKPATH, 8, 154, 326, 10
END

IDD_PG_FOLDERS DIALOGEX 0, 0, 342, 272
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Cartella di download", -1, 0, 0, 342, 50
    EDITTEXT        IDC_FOLDER, 8, 14, 270, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Sfoglia...", IDC_BROWSE, 284, 13, 50, 15
    LTEXT           "Vale per i nuovi torrent; quelli già aggiunti restano nella loro cartella.", -1, 8, 32, 326, 9
    GROUPBOX        "Disco", -1, 0, 56, 342, 32
    AUTOCHECKBOX    "Prealloca lo spazio dei nuovi torrent (riduce la frammentazione)", IDC_PREALLOC, 8, 70, 326, 10
END

IDD_PG_CONNECTION DIALOGEX 0, 0, 342, 272
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Porta di ascolto (TCP e uTP)", -1, 0, 0, 342, 40
    EDITTEXT        IDC_PORT, 8, 16, 56, 13, ES_NUMBER | WS_TABSTOP
    PUSHBUTTON      "Porta casuale", IDC_RANDOMPORT, 70, 15, 64, 15
    LTEXT           "Usa una porta tra 10000 e 65535; la 6881-6889 è spesso filtrata dai provider.", -1, 142, 13, 192, 20
    GROUPBOX        "Apertura porta sul router", -1, 0, 46, 342, 56
    AUTOCHECKBOX    "UPnP (apertura automatica della porta)", IDC_UPNP, 8, 60, 326, 10
    AUTOCHECKBOX    "NAT-PMP / PCP (apertura automatica della porta)", IDC_NATPMP, 8, 74, 326, 10
    AUTOCHECKBOX    "Verifica la porta online all'avvio (servizio ifconfig.co)", IDC_AUTOCHECK, 8, 88, 326, 10
    GROUPBOX        "Protocollo", -1, 0, 108, 342, 84
    AUTOCHECKBOX    "Usa anche IPv6 (disattiva se la tua linea non ha IPv6 funzionante)", IDC_IPV6, 8, 122, 326, 10
    LTEXT           "Cifratura del protocollo", -1, 8, 138, 326, 9
    COMBOBOX        IDC_ENCRYPTION, 8, 149, 326, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "«Richiesta» riduce i peer disponibili ma evita il traffico in chiaro (utile con provider che rallentano il BitTorrent).", -1, 8, 166, 326, 18
END

IDD_PG_BANDWIDTH DIALOGEX 0, 0, 342, 272
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Limiti globali di velocità (0 = illimitato)", -1, 0, 0, 342, 50
    LTEXT           "Download (KiB/s)", -1, 8, 16, 76, 9
    EDITTEXT        IDC_DOWN, 86, 14, 60, 13, ES_NUMBER | WS_TABSTOP
    LTEXT           "Upload (KiB/s)", -1, 176, 16, 70, 9
    EDITTEXT        IDC_UP, 248, 14, 60, 13, ES_NUMBER | WS_TABSTOP
    LTEXT           "1 Gb/s = 122.070 KiB/s. Lascia un 10-20% di margine sull'upload reale per non saturare la linea.", -1, 8, 33, 326, 9
    GROUPBOX        "Connessioni", -1, 0, 56, 342, 50
    LTEXT           "Connessioni max", -1, 8, 72, 76, 9
    EDITTEXT        IDC_CONNECTIONS, 86, 70, 60, 13, ES_NUMBER | WS_TABSTOP
    LTEXT           "Slot upload", -1, 176, 72, 70, 9
    EDITTEXT        IDC_SLOTS, 248, 70, 60, 13, WS_TABSTOP
    LTEXT           "Slot upload: -1 = illimitati (consigliato con fibra veloce).", -1, 8, 89, 326, 9
END

IDD_PG_BITTORRENT DIALOGEX 0, 0, 342, 272
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Scoperta dei peer", -1, 0, 0, 342, 70
    AUTOCHECKBOX    "DHT (rete decentralizzata)", IDC_DHT, 8, 14, 326, 10
    AUTOCHECKBOX    "PeX, scambio dei peer (al riavvio)", IDC_PEX, 8, 28, 326, 10
    AUTOCHECKBOX    "LSD, scoperta in rete locale", IDC_LSD, 8, 42, 326, 10
    LTEXT           "Sui torrent privati DHT, PeX e LSD sono sempre disattivati.", -1, 8, 56, 326, 9
    GROUPBOX        "Tracker", -1, 0, 76, 342, 48
    AUTOCHECKBOX    "Annuncia sempre a tutti i tracker dello stesso livello (tier)", IDC_ALLTRACKERS, 8, 90, 326, 10
    AUTOCHECKBOX    "Annuncia sempre a tutti i livelli (tier) di tracker", IDC_ALLTIERS, 8, 104, 326, 10
END

IDD_PG_QUEUE DIALOGEX 0, 0, 342, 272
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Code automatiche", -1, 0, 0, 342, 34
    LTEXT           "Download attivi", -1, 8, 16, 76, 9
    EDITTEXT        IDC_ACTIVEDL, 86, 14, 60, 13, ES_NUMBER | WS_TABSTOP
    LTEXT           "Seed attivi", -1, 176, 16, 70, 9
    EDITTEXT        IDC_ACTIVESEED, 248, 14, 60, 13, ES_NUMBER | WS_TABSTOP
    GROUPBOX        "Ratio globale (vale per i torrent impostati su «globale»)", -1, 0, 40, 342, 84
    AUTOCHECKBOX    "Al raggiungimento del ratio", IDC_RATIOON, 8, 56, 120, 10
    EDITTEXT        IDC_RATIO, 130, 54, 40, 13, WS_TABSTOP
    COMBOBOX        IDC_RATIOACTION, 8, 72, 326, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Il ratio è caricati / scaricati; per i torrent aggiunti già completi si usa la dimensione completata. Se riavvii a mano un torrent che ha già raggiunto il limite, l'azione non viene ripetuta finché non cambi il limite.", -1, 8, 90, 326, 28
END

IDD_PG_IDENTITY DIALOGEX 0, 0, 342, 272
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Preset (imposta insieme User-Agent, peer ID e nome nell'handshake)", -1, 8, 0, 284, 9
    COMBOBOX        IDC_UA_PRESET, 8, 12, 284, 140, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "User-Agent HTTP (tracker e web seed)", -1, 8, 32, 284, 9
    EDITTEXT        IDC_UA_VALUE, 8, 43, 284, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Prefisso peer ID (es. -qB5140-)", -1, 8, 62, 140, 9
    EDITTEXT        IDC_UA_PEERID, 8, 73, 140, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Nome client nell'handshake", -1, 154, 62, 138, 9
    EDITTEXT        IDC_UA_CLIENT, 154, 73, 138, 13, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Invia il nome del client nell'handshake BitTorrent (extension protocol)", IDC_UA_HANDSHAKE, 8, 92, 284, 10
    AUTOCHECKBOX    "Modalità anonima (non rivela client, versione e porta di ascolto)", IDC_UA_ANON, 8, 106, 284, 10
    LTEXT           "Il resto del peer ID è casuale. L'emulazione copre User-Agent, prefisso del peer ID e nome nell'handshake, non il comportamento di rete.", -1, 8, 122, 284, 22
    LTEXT           "Alcuni tracker privati riconoscono il client: aggirarne la whitelist viola le loro regole (rischio di ban). Campi vuoti = identità SeedFlow.", -1, 8, 148, 284, 26
END

IDD_PG_SYSTEM DIALOGEX 0, 0, 342, 272
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Priorità del processo", -1, 0, 0, 342, 48
    COMBOBOX        IDC_PRIORITY, 8, 14, 160, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "«Sotto il normale» lascia la precedenza a giochi e programmi in primo piano.", -1, 8, 32, 326, 9
    LTEXT           "Thread del disco e della verifica hash, cache e memoria: Avanzate › Prestazioni e memoria.", -1, 0, 56, 342, 9
END

