IDD_ABOUT DIALOGEX 0, 0, 320, 230
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Informazioni su SeedFlow"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    ICON            IDI_APP, IDC_LOGO, 10, 10, 32, 32, SS_REALSIZEIMAGE
    LTEXT           "SeedFlow", IDC_TITLE, 52, 10, 260, 16
    LTEXT           "", IDC_VERSION, 52, 28, 260, 18
    EDITTEXT        IDC_REPORT, 10, 52, 300, 132, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    CONTROL         "<a href=""https://www.libtorrent.org"">libtorrent.org</a>", IDC_LINK, "SysLink", WS_TABSTOP, 10, 190, 120, 10
    PUSHBUTTON      "Copia info di sistema", IDC_COPY, 10, 208, 86, 15
    PUSHBUTTON      "Cartella dati", IDC_DATAFOLDER, 100, 208, 60, 15
    DEFPUSHBUTTON   "OK", IDOK, 260, 208, 50, 15
END

IDD_ADDTORRENT DIALOGEX 0, 0, 340, 126
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Aggiungi torrent"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_A_INFO, 8, 8, 324, 20
    LTEXT           "Salva in:", -1, 8, 32, 324, 9
    COMBOBOX        IDC_A_FOLDER, 8, 43, 276, 120, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Sfoglia...", IDC_BROWSE, 288, 42, 44, 15
    AUTOCHECKBOX    "Aggiungi in pausa", IDC_PAUSED, 8, 63, 324, 10
    AUTOCHECKBOX    "Non chiedere più: usa sempre la cartella predefinita", IDC_A_NOASK, 8, 77, 324, 10
    LTEXT           "Puoi riattivare la richiesta in Preferenze › Generale.", -1, 20, 89, 312, 9
    DEFPUSHBUTTON   "Aggiungi", IDOK, 228, 106, 50, 14
    PUSHBUTTON      "Annulla", IDCANCEL, 282, 106, 50, 14
END

IDD_CREATE DIALOGEX 0, 0, 360, 300
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_ACCEPTFILES
CAPTION "Crea torrent"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "File o cartella da condividere (puoi anche trascinarlo qui)", -1, 8, 8, 344, 9
    EDITTEXT        IDC_C_SOURCE, 8, 19, 236, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "File...", IDC_C_FILE, 248, 18, 50, 15
    PUSHBUTTON      "Cartella...", IDC_C_FOLDER, 302, 18, 50, 15
    LTEXT           "", IDC_C_INFO, 8, 35, 344, 9
    LTEXT           "Tracker (uno per riga; una riga vuota separa i livelli)", -1, 8, 48, 344, 9
    EDITTEXT        IDC_C_TRACKERS, 8, 59, 344, 52, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Web seed (URL http/https, uno per riga)", -1, 8, 116, 344, 9
    EDITTEXT        IDC_C_WEBSEEDS, 8, 127, 344, 26, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Commento", -1, 8, 158, 344, 9
    EDITTEXT        IDC_C_COMMENT, 8, 169, 344, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Formato", -1, 8, 188, 170, 9
    COMBOBOX        IDC_C_FORMAT, 8, 199, 170, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Dimensione dei pezzi", -1, 186, 188, 166, 9
    COMBOBOX        IDC_C_PIECE, 186, 199, 166, 140, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Torrent privato (solo tracker: niente DHT, PeX e LSD)", IDC_C_PRIVATE, 8, 218, 344, 10
    AUTOCHECKBOX    "Avvia subito il seeding", IDC_C_SEED, 8, 232, 170, 10
    AUTOCHECKBOX    "Copia il magnet negli appunti", IDC_C_MAGNET, 186, 232, 166, 10
    CONTROL         "", IDC_C_PROGRESS, "Static", SS_OWNERDRAW, 8, 248, 344, 11
    LTEXT           "", IDC_C_STATUS, 8, 263, 344, 9
    DEFPUSHBUTTON   "Crea...", IDOK, 248, 280, 50, 14
    PUSHBUTTON      "Chiudi", IDCANCEL, 302, 280, 50, 14
END

IDD_RATIO DIALOGEX 0, 0, 260, 150
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Limite ratio del torrent"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_R_CURRENT, 8, 8, 244, 18
    AUTORADIOBUTTON "Usa l'impostazione globale", IDC_R_GLOBAL, 8, 30, 240, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Nessun limite per questo torrent", IDC_R_NONE, 8, 44, 240, 10
    AUTORADIOBUTTON "Limite personalizzato:", IDC_R_CUSTOM, 8, 58, 100, 10
    EDITTEXT        IDC_RATIO, 110, 56, 40, 13, WS_TABSTOP | WS_GROUP
    LTEXT           "Azione al raggiungimento", -1, 8, 78, 120, 9
    COMBOBOX        IDC_RATIOACTION, 8, 90, 244, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    DEFPUSHBUTTON   "Salva", IDOK, 148, 128, 50, 14
    PUSHBUTTON      "Annulla", IDCANCEL, 202, 128, 50, 14
END

IDD_LIMITS DIALOGEX 0, 0, 220, 96
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Limiti di velocità del torrent"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Download (KiB/s, 0 = illimitato)", -1, 8, 10, 130, 9
    EDITTEXT        IDC_DOWN, 150, 8, 60, 13, ES_NUMBER | WS_TABSTOP
    LTEXT           "Upload (KiB/s, 0 = illimitato)", -1, 8, 30, 130, 9
    EDITTEXT        IDC_UP, 150, 28, 60, 13, ES_NUMBER | WS_TABSTOP
    DEFPUSHBUTTON   "Salva", IDOK, 106, 74, 50, 14
    PUSHBUTTON      "Annulla", IDCANCEL, 160, 74, 50, 14
END

IDD_TRACKERS DIALOGEX 0, 0, 320, 160
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Aggiungi tracker"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Un URL per riga (http, https, udp, wss). Una riga vuota separa i livelli (tier): i tracker dello stesso livello sono alternativi.", -1, 8, 6, 304, 18
    EDITTEXT        IDC_EDIT, 8, 28, 304, 106, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "Aggiungi", IDOK, 208, 140, 50, 14
    PUSHBUTTON      "Annulla", IDCANCEL, 262, 140, 50, 14
END

