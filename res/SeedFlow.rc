// SeedFlow resources (UTF-8)
#pragma code_page(65001)
#include <winres.h>
#include "../src/resource.h"
#include "../src/version.h"

LANGUAGE LANG_ITALIAN, SUBLANG_ITALIAN

IDI_APP ICON "SeedFlow.ico"

// Icon set (stile A) - strisce PNG generate da tools/make_icons.py; ID = IDR_ICONS_BASE + dimensione
2016 RCDATA "icons/strip16.png"
2020 RCDATA "icons/strip20.png"
2024 RCDATA "icons/strip24.png"
2028 RCDATA "icons/strip28.png"
2032 RCDATA "icons/strip32.png"
2040 RCDATA "icons/strip40.png"
2048 RCDATA "icons/strip48.png"
1 24 "SeedFlow.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SF_FILE_VERSION
 PRODUCTVERSION SF_FILE_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041004b0"
        BEGIN
            VALUE "CompanyName", "SeedFlow"
            VALUE "FileDescription", "SeedFlow - client BitTorrent"
            VALUE "FileVersion", SF_FILE_VERSION_STRING
            VALUE "InternalName", "SeedFlow"
            VALUE "OriginalFilename", "SeedFlow.exe"
            VALUE "ProductName", "SeedFlow"
            VALUE "ProductVersion", SF_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x410, 1200
    END
END

IDR_ACCEL ACCELERATORS
BEGIN
    "O", ID_FILE_OPEN, VIRTKEY, CONTROL
    "U", ID_FILE_MAGNET, VIRTKEY, CONTROL
    "V", ID_FILE_PASTE, VIRTKEY, CONTROL
    "N", ID_FILE_CREATE, VIRTKEY, CONTROL
    "A", ID_T_SELECTALL, VIRTKEY, CONTROL
    VK_DELETE, ID_T_REMOVE, VIRTKEY
    VK_DELETE, ID_T_DELETE, VIRTKEY, SHIFT
    VK_F5, ID_T_REANNOUNCE, VIRTKEY
    "P", ID_OPT_PREFS, VIRTKEY, CONTROL
END

IDR_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "Apri file .torrent...\tCtrl+O", ID_FILE_OPEN
        MENUITEM "Aggiungi magnet...\tCtrl+U", ID_FILE_MAGNET
        MENUITEM "Incolla magnet dagli appunti\tCtrl+V", ID_FILE_PASTE
        MENUITEM SEPARATOR
        MENUITEM "Crea torrent...\tCtrl+N", ID_FILE_CREATE
        MENUITEM SEPARATOR
        MENUITEM "Avvia tutti", ID_T_STARTALL
        MENUITEM "Metti tutti in pausa", ID_T_PAUSEALL
        MENUITEM SEPARATOR
        MENUITEM "Esci", ID_FILE_EXIT
    END
    POPUP "&Opzioni"
    BEGIN
        MENUITEM "Chiudi nell'area di notifica (X)", ID_OPT_CLOSETRAY
        MENUITEM "Minimizza nell'area di notifica", ID_OPT_MINTRAY
        MENUITEM "Aggiungi i nuovi torrent in pausa", ID_OPT_STARTPAUSED
        MENUITEM "Chiedi conferma prima di rimuovere", ID_OPT_CONFIRMREMOVE
        MENUITEM SEPARATOR
        MENUITEM "Preferenze...\tCtrl+P", ID_OPT_PREFS
    END
    POPUP "&Strumenti"
    BEGIN
        MENUITEM "Ottimizza per la mia connessione...", ID_TOOLS_WIZARD
        MENUITEM "Diagnostica rete...", ID_TOOLS_DIAG
        MENUITEM "Statistiche...", ID_TOOLS_STATS
        MENUITEM SEPARATOR
        MENUITEM "Apri cartella dati SeedFlow", ID_TOOLS_DATAFOLDER
    END
    POPUP "&Aiuto"
    BEGIN
        MENUITEM "Novità di questa versione", ID_HELP_RELEASES
        MENUITEM "Pagina del progetto su GitHub", ID_HELP_GITHUB
        MENUITEM "Segnala un problema...", ID_HELP_REPORT
        MENUITEM SEPARATOR
        MENUITEM "Informazioni su SeedFlow", ID_HELP_ABOUT
    END
END

IDR_CTX_TORRENT MENU
BEGIN
    POPUP "torrent"
    BEGIN
        MENUITEM "Avvia", ID_T_START
        MENUITEM "Avvio forzato (ignora la coda)", ID_T_FORCESTART
        MENUITEM "Pausa", ID_T_PAUSE
        MENUITEM SEPARATOR
        MENUITEM "Copia magnet", ID_T_COPYMAGNET
        MENUITEM "Apri cartella", ID_T_OPENFOLDER
        MENUITEM "Sposta in un'altra cartella...", ID_T_MOVE
        MENUITEM SEPARATOR
        MENUITEM "Limite ratio...", ID_T_RATIO
        MENUITEM "Limiti di velocità...", ID_T_LIMITS
        MENUITEM "Attiva/disattiva Super-seeding", ID_T_SUPERSEED
        POPUP "Coda"
        BEGIN
            MENUITEM "In cima", ID_T_QTOP
            MENUITEM "Su", ID_T_QUP
            MENUITEM "Giù", ID_T_QDOWN
            MENUITEM "In fondo", ID_T_QBOTTOM
        END
        MENUITEM "Riannuncia ai tracker\tF5", ID_T_REANNOUNCE
        MENUITEM "Verifica forzata", ID_T_RECHECK
        MENUITEM SEPARATOR
        MENUITEM "Rimuovi (conserva i file)\tCanc", ID_T_REMOVE
        MENUITEM "Rimuovi e cancella i file\tMaiusc+Canc", ID_T_DELETE
    END
END

IDR_CTX_TRACKER MENU
BEGIN
    POPUP "tracker"
    BEGIN
        MENUITEM "Aggiungi tracker...", ID_TR_ADD
        MENUITEM "Rimuovi tracker selezionati", ID_TR_REMOVE
        MENUITEM "Copia URL", ID_TR_COPY
        MENUITEM SEPARATOR
        MENUITEM "Riannuncia ora", ID_TR_REANNOUNCE
    END
END

IDR_CTX_FILE MENU
BEGIN
    POPUP "file"
    BEGIN
        MENUITEM "Apri", ID_F_OPEN
        MENUITEM SEPARATOR
        MENUITEM "Non scaricare", ID_F_SKIP
        MENUITEM "Priorità bassa", ID_F_LOW
        MENUITEM "Priorità normale", ID_F_NORMAL
        MENUITEM "Priorità alta", ID_F_HIGH
    END
END

IDR_CTX_TRAY MENU
BEGIN
    POPUP "tray"
    BEGIN
        MENUITEM "Apri SeedFlow", ID_TRAY_OPEN
        MENUITEM SEPARATOR
        MENUITEM "Avvia tutti", ID_T_STARTALL
        MENUITEM "Metti tutti in pausa", ID_T_PAUSEALL
        MENUITEM SEPARATOR
        MENUITEM "Chiudi nell'area di notifica (X)", ID_OPT_CLOSETRAY
        MENUITEM "Minimizza nell'area di notifica", ID_OPT_MINTRAY
        MENUITEM SEPARATOR
        MENUITEM "Esci", ID_FILE_EXIT
    END
END

// ------------------------------------------------------------------ dialogs
IDD_MAGNET DIALOGEX 0, 0, 340, 168
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Aggiungi magnet"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Incolla uno o più magnet link (uno per riga):", -1, 8, 8, 320, 9
    EDITTEXT        IDC_EDIT, 8, 20, 324, 76, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Salva in:", -1, 8, 104, 40, 9
    COMBOBOX        IDC_FOLDER, 8, 115, 276, 120, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Sfoglia...", IDC_BROWSE, 288, 114, 44, 15
    AUTOCHECKBOX    "Aggiungi in pausa", IDC_PAUSED, 8, 134, 120, 10
    DEFPUSHBUTTON   "Aggiungi", IDOK, 228, 148, 50, 14
    PUSHBUTTON      "Annulla", IDCANCEL, 282, 148, 50, 14
END

// ------------------------------------------------------------------ preferences (unified, uTorrent style)
// Page area 276 x 272 DLU; controls inside a group start at x 8 and end at 268.
IDD_PREFS DIALOGEX 0, 0, 404, 326
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Preferenze"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "", IDC_PREFTREE, "SysTreeView32", TVS_SHOWSELALWAYS | TVS_FULLROWSELECT | TVS_HASBUTTONS | TVS_LINESATROOT | TVS_TRACKSELECT | WS_BORDER | WS_TABSTOP, 8, 8, 104, 290
    LTEXT           "", IDC_PAGETITLE, 120, 8, 276, 12
    CONTROL         "", -1, "Static", SS_ETCHEDHORZ, 120, 22, 276, 1
    LTEXT           "", IDC_PAGEAREA, 120, 28, 276, 272, NOT WS_VISIBLE
    DEFPUSHBUTTON   "OK", IDOK, 238, 306, 50, 14
    PUSHBUTTON      "Annulla", IDCANCEL, 292, 306, 50, 14
    PUSHBUTTON      "Applica", IDC_APPLYNOW, 346, 306, 50, 14
END

IDD_PG_GENERAL DIALOGEX 0, 0, 276, 272
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
