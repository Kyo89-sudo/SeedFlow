    EDITTEXT        IDC_FIELD0+5, 162, 102, 56, 13, ES_NUMBER | WS_TABSTOP
    LTEXT           "", IDC_FUNIT0+5, 222, 104, 30, 9
    RTEXT           "", IDC_FLABEL0+6, 8, 120, 150, 9
    EDITTEXT        IDC_FIELD0+6, 162, 118, 56, 13, ES_NUMBER | WS_TABSTOP
