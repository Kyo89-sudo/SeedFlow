END

IDD_PG_FOLDERS DIALOGEX 0, 0, 276, 272
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Cartella di download", -1, 0, 0, 276, 50
    EDITTEXT        IDC_FOLDER, 8, 13, 204, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "Sfoglia...", IDC_BROWSE, 218, 12, 50, 15
    LTEXT           "Vale per i nuovi torrent; quelli già aggiunti restano dove sono.", -1, 8, 32, 260, 9
    GROUPBOX        "Disco", -1, 0, 56, 276, 40
    AUTOCHECKBOX    "Prealloca lo spazio dei nuovi torrent", IDC_PREALLOC, 8, 68, 260, 10
