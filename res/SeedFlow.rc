END

IDD_PG_CONNECTION DIALOGEX 0, 0, 276, 272
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Porta di ascolto (TCP e uTP)", -1, 0, 0, 276, 62
    EDITTEXT        IDC_PORT, 8, 13, 50, 13, ES_NUMBER | WS_TABSTOP
    PUSHBUTTON      "Casuale", IDC_RANDOMPORT, 62, 12, 50, 15
    AUTOCHECKBOX    "Porta casuale a ogni avvio", IDC_RANDOMSTART, 8, 32, 260, 10
    LTEXT           "Meglio tra 10000 e 65535; 6881-6889 è spesso filtrata.", -1, 8, 46, 260, 9
    GROUPBOX        "Router", -1, 0, 68, 276, 56
    AUTOCHECKBOX    "UPnP", IDC_UPNP, 8, 80, 260, 10
    AUTOCHECKBOX    "NAT-PMP / PCP", IDC_NATPMP, 8, 94, 260, 10
    AUTOCHECKBOX    "Verifica la porta online all'avvio (ifconfig.co)", IDC_AUTOCHECK, 8, 108, 260, 10
    GROUPBOX        "Protocollo", -1, 0, 130, 276, 70
    AUTOCHECKBOX    "Usa anche IPv6", IDC_IPV6, 8, 142, 260, 10
    LTEXT           "Cifratura", -1, 8, 159, 40, 9
    COMBOBOX        IDC_ENCRYPTION, 50, 157, 218, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "«Richiesta» evita il traffico in chiaro ma riduce i peer.", -1, 8, 176, 260, 18
END

IDD_PG_BANDWIDTH DIALOGEX 0, 0, 276, 272
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Limiti globali (KiB/s, 0 = illimitato)", -1, 0, 0, 276, 60
    LTEXT           "Download", -1, 8, 15, 50, 9
    EDITTEXT        IDC_DOWN, 60, 13, 60, 13, ES_NUMBER | WS_TABSTOP
    LTEXT           "Upload", -1, 140, 15, 50, 9
    EDITTEXT        IDC_UP, 192, 13, 60, 13, ES_NUMBER | WS_TABSTOP
    LTEXT           "1 Gb/s = 122.070 KiB/s. Tieni l'upload 10-20% sotto quello reale.", -1, 8, 32, 260, 18
    GROUPBOX        "Connessioni", -1, 0, 66, 276, 50
    LTEXT           "Massime", -1, 8, 81, 50, 9
    EDITTEXT        IDC_CONNECTIONS, 60, 79, 60, 13, ES_NUMBER | WS_TABSTOP
    LTEXT           "Slot upload", -1, 140, 81, 50, 9
    EDITTEXT        IDC_SLOTS, 192, 79, 60, 13, WS_TABSTOP
    LTEXT           "Slot upload -1 = illimitati (consigliato con fibra).", -1, 8, 99, 260, 9
END

IDD_PG_BITTORRENT DIALOGEX 0, 0, 276, 272
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Scoperta dei peer", -1, 0, 0, 276, 68
    AUTOCHECKBOX    "DHT (rete decentralizzata)", IDC_DHT, 8, 12, 260, 10
    AUTOCHECKBOX    "PeX, scambio dei peer (al riavvio)", IDC_PEX, 8, 26, 260, 10
    AUTOCHECKBOX    "LSD, scoperta in rete locale", IDC_LSD, 8, 40, 260, 10
    LTEXT           "Sui torrent privati sono sempre disattivati.", -1, 8, 54, 260, 9
    GROUPBOX        "Tracker", -1, 0, 74, 276, 42
    AUTOCHECKBOX    "Annuncia a tutti i tracker dello stesso livello", IDC_ALLTRACKERS, 8, 86, 260, 10
    AUTOCHECKBOX    "Annuncia a tutti i livelli (tier)", IDC_ALLTIERS, 8, 100, 260, 10
END

IDD_PG_QUEUE DIALOGEX 0, 0, 276, 272
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Code automatiche", -1, 0, 0, 276, 34
    LTEXT           "Download attivi", -1, 8, 15, 56, 9
    EDITTEXT        IDC_ACTIVEDL, 66, 13, 50, 13, ES_NUMBER | WS_TABSTOP
    LTEXT           "Seed attivi", -1, 140, 15, 50, 9
    EDITTEXT        IDC_ACTIVESEED, 192, 13, 50, 13, ES_NUMBER | WS_TABSTOP
    GROUPBOX        "Ratio globale (torrent impostati su «globale»)", -1, 0, 40, 276, 94
    AUTOCHECKBOX    "Al raggiungimento del ratio", IDC_RATIOON, 8, 54, 110, 10
    EDITTEXT        IDC_RATIO, 120, 52, 40, 13, WS_TABSTOP
    COMBOBOX        IDC_RATIOACTION, 8, 70, 260, 80, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "Ratio = caricati / scaricati (per i torrent aggiunti già completi si usa la dimensione). Un torrent riavviato a mano dopo il limite non ripete l'azione finché non cambi il limite.", -1, 8, 88, 260, 40
END

IDD_PG_IDENTITY DIALOGEX 0, 0, 276, 272
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Preset (User-Agent, peer ID e nome nell'handshake)", -1, 0, 0, 276, 9
    COMBOBOX        IDC_UA_PRESET, 0, 11, 276, 140, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "User-Agent HTTP (tracker e web seed)", -1, 0, 30, 276, 9
    EDITTEXT        IDC_UA_VALUE, 0, 41, 276, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Prefisso peer ID (es. -qB5300-)", -1, 0, 60, 134, 9
    EDITTEXT        IDC_UA_PEERID, 0, 71, 134, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Nome nell'handshake", -1, 142, 60, 134, 9
    EDITTEXT        IDC_UA_CLIENT, 142, 71, 134, 13, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Invia il nome del client nell'handshake", IDC_UA_HANDSHAKE, 0, 90, 276, 10
    AUTOCHECKBOX    "Modalità anonima (nasconde client, versione e porta)", IDC_UA_ANON, 0, 104, 276, 10
    LTEXT           "Il resto del peer ID è casuale. Si emulano User-Agent, prefisso e nome, non il comportamento di rete.", -1, 0, 120, 276, 18
    LTEXT           "Alcuni tracker privati accettano solo client noti: aggirarne la whitelist viola le loro regole (rischio di ban). Campi vuoti = identità SeedFlow.", -1, 0, 142, 276, 26
END

IDD_PG_SYSTEM DIALOGEX 0, 0, 276, 272
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
