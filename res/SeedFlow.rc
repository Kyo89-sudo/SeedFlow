IDD_STATS DIALOGEX 0, 0, 380, 290
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Statistiche"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_REPORT, 8, 8, 364, 252, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON      "Azzera storico...", IDC_RESETSTATS, 8, 268, 70, 15
    PUSHBUTTON      "Copia", IDC_COPY, 82, 268, 50, 15
    DEFPUSHBUTTON   "Chiudi", IDCANCEL, 322, 268, 50, 15
END

IDD_ABOUT DIALOGEX 0, 0, 320, 252
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
